recursive-include src/annoweave/assets *.svg *.png *.ico *.md
include README.md README_zh-CN.md
include CHANGELOG.md
include LICENSE

# The README demo animation (~2 MB) lives in the repository for GitHub to render but is
# deliberately kept out of the source distribution: an sdist consumer does not need it.
prune docs/assets

# The public repository boundary and its checks ship with the source distribution so a
# downstream packager can re-verify the same rules.
recursive-include scripts *.ps1
recursive-include tests *.py

prune build
prune dist
prune .venv
global-exclude *.py[cod]
global-exclude __pycache__
