# AnnoWeave reads environment variables from the process, not from this file.
# It does not load .env automatically. In PowerShell set the variable first:
#
#   $env:ANNOWEAVE_CONFIG_DIR = "D:\AnnoWeaveData"
#   .\scripts\run.ps1

# Optional. Relocates ALL local AnnoWeave state into one directory: the model
# library, workflow catalog, per-project review databases, label catalog,
# plugins, review sessions, and the precompute cache. It also accepts UNC and
# relative paths. Leave it unset to use the default %LOCALAPPDATA%\AnnoWeave.
ANNOWEAVE_CONFIG_DIR=D:\AnnoWeaveData
